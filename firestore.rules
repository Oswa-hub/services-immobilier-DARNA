rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    // Module 14: suspended / banned / deleted accounts cannot file reports.
    function isActiveAccount() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'active') == 'active';
    }
    function unchanged(keys) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }

    // ---- Module 01: users ---------------------------------------------------
    // `role` is client-writable in ONE case only: a verified, active `user` may set
    // their own role to `owner` (B2, last branch of `update`). The agent role is
    // granted by the onAgentProfileCreated Cloud Function (Module 10).
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();

      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(
             ['id', 'name', 'email', 'phone', 'role', 'status', 'verified', 'createdAt'])
        && request.resource.data.id == uid
        && request.resource.data.role == 'user'
        && request.resource.data.status == 'active'
        && request.resource.data.verified == false
        && request.resource.data.email == request.auth.token.email;

      allow update: if (isSelf(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['name', 'phone', 'photoUrl', 'preferredCity', 'notificationPreferences']))
        // B2: a verified, active plain user may promote THEMSELVES to owner, once.
        // Only `role` may change, and only user -> owner. agent / admin stay out of reach.
        || (isSelf(uid)
            && request.auth.token.email_verified == true
            && resource.data.status == 'active'
            && resource.data.role == 'user'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
            && request.resource.data.role == 'owner')
        // Module 15: admins manage accounts, but never their OWN role / status
        // (no self-lockout, no silent self-promotion trail).
        || (isAdmin()
            && (uid != request.auth.uid
                || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status'])));

      allow delete: if false;

      // ---- Module 14: users I blocked (they can no longer message me) ---------
      match /blocked/{otherId} {
        allow read, delete: if isSelf(uid);
        allow create, update: if isSelf(uid)
          && otherId != uid
          && request.resource.data.keys().hasOnly(['name', 'createdAt'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 80
          && request.resource.data.createdAt == request.time;
      }

      // ---- Module 12: push devices (FCM tokens), one doc per token ------------
      // Written by the app on sign-in; the server prunes dead tokens and removes a
      // token from any other account (dedupeDeviceToken function).
      match /devices/{deviceId} {
        allow read, delete: if isSelf(uid);
        allow create, update: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['token', 'platform', 'createdAt', 'updatedAt'])
          && request.resource.data.token is string
          && request.resource.data.token == deviceId
          && request.resource.data.token.size() > 0 && request.resource.data.token.size() <= 1024
          && request.resource.data.platform in ['android', 'ios', 'web', 'macos', 'windows', 'linux']
          && request.resource.data.updatedAt == request.time;
      }
    }

    // ---- Module 08: who may publish + what a NEW listing must look like -------
    function publisherData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Owner or agent, verified email, active account. (Admins are handled by isAdmin().)
    function canPublish() {
      return signedIn()
        && request.auth.token.email_verified == true
        && publisherData().status == 'active'
        && publisherData().role in ['owner', 'agent'];
    }

    // Mirrors PublishingConfig + PropertyWriteMapper (Flutter). Change them together.
    function validNewListing(d) {
      return d.keys().hasAll(['ownerId', 'agentId', 'ownerRole', 'title', 'description',
             'transactionType', 'propertyType', 'price', 'currency', 'surface', 'isStudio',
             'isNewBuild', 'governorate', 'city', 'images', 'amenities', 'status',
             'verificationStatus', 'views', 'favoritesCount', 'createdAt', 'updatedAt', 'publishedAt'])
        && d.keys().hasOnly(['ownerId', 'agentId', 'ownerName', 'ownerRole', 'title', 'description',
             'transactionType', 'propertyType', 'price', 'currency', 'surface', 'bedrooms', 'bathrooms',
             'isStudio', 'isNewBuild', 'governorate', 'city', 'area', 'latitude', 'longitude',
             'images', 'amenities', 'status', 'verificationStatus', 'views', 'favoritesCount',
             'createdAt', 'updatedAt', 'publishedAt'])

        // Ownership: the creator is the owner; only a real agent account sets agentId.
        && d.ownerId == request.auth.uid
        && ((d.agentId == null && d.ownerRole == 'owner' && publisherData().role == 'owner')
            || (d.agentId == request.auth.uid && d.ownerRole == 'agent' && publisherData().role == 'agent'))
        && (!('ownerName' in d) || (d.ownerName is string && d.ownerName.size() <= 120))

        // Lifecycle: a new listing is ALWAYS in moderation, with clean counters.
        && d.status == 'pending_review'
        && d.verificationStatus == 'not_submitted'
        && d.views == 0
        && d.favoritesCount == 0
        && d.publishedAt == null
        && d.createdAt == request.time
        && d.updatedAt == request.time

        // Content.
        && d.title is string && d.title.trim().size() >= 5 && d.title.size() <= 100
        && d.description is string && d.description.trim().size() >= 20 && d.description.size() <= 2000
        && d.transactionType in ['buy', 'rent']
        && d.propertyType in ['apartment', 'villa', 'house', 'duplex', 'triplex', 'land',
                              'office', 'commercial', 'industrial']
        && d.price is number && d.price > 0 && d.price <= 1000000000
        && d.currency == 'TND'
        && d.surface is number && d.surface > 0 && d.surface <= 1000000
        && d.isStudio is bool
        && d.isNewBuild is bool
        && (!('bedrooms' in d) || (d.bedrooms is int && d.bedrooms >= 0 && d.bedrooms <= 20))
        && (!('bathrooms' in d) || (d.bathrooms is int && d.bathrooms >= 0 && d.bathrooms <= 20))

        // Location.
        && d.governorate in ['Tunis', 'Ariana', 'Ben Arous', 'Manouba', 'Nabeul', 'Zaghouan',
             'Bizerte', 'Béja', 'Jendouba', 'Le Kef', 'Siliana', 'Sousse', 'Monastir', 'Mahdia',
             'Sfax', 'Kairouan', 'Kasserine', 'Sidi Bouzid', 'Gabès', 'Médenine', 'Tataouine',
             'Gafsa', 'Tozeur', 'Kébili']
        && d.city is string && d.city.trim().size() > 0 && d.city.size() <= 80
        && (!('area' in d) || (d.area is string && d.area.size() <= 80))
        && (('latitude' in d) == ('longitude' in d))
        && (!('latitude' in d)
            || (d.latitude is number && d.longitude is number
                && d.latitude >= 30 && d.latitude <= 37.6
                && d.longitude >= 7.4 && d.longitude <= 11.7))

        // Media + amenities. Rules cannot loop, so only the cover URL is pattern-checked.
        && d.images is list && d.images.size() >= 1 && d.images.size() <= 10
        && d.images[0] is string && d.images[0].matches('^https://res\\.cloudinary\\.com/.+')
        && d.amenities is list && d.amenities.size() <= 10
        && d.amenities.hasOnly(['parking', 'pool', 'elevator', 'garden', 'seaView', 'centralHeating',
                                'airConditioning', 'security', 'terrace', 'balcony']);
    }

    // ---- Module 09: lifecycle moves by the listing's owner or its agent ------
    function isListingManager() {
      return signedIn()
        && (resource.data.ownerId == request.auth.uid
            || resource.data.agentId == request.auth.uid);
    }

    // Same table as `ownerLifecycle` in Flutter (listing_lifecycle.dart). Change them together.
    function lifecycleMove() {
      let before = resource.data.status;
      let after  = request.resource.data.status;
      return isListingManager()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && (
             // Submit for review: needs an active, verified owner/agent (same gate as create).
             (before in ['draft', 'rejected'] && after == 'pending_review' && canPublish())
             // Back to draft, to fix and resubmit.
          || (before in ['rejected', 'removed'] && after == 'draft')
             // Withdraw. Never from `suspended`: that is a moderation hold.
          || (before in ['draft', 'pending_review', 'published', 'rejected', 'expired']
              && after == 'removed')
        );
    }

    // ---- Module 03 + 08 + 09 + 10: properties ---------------------------------
    match /properties/{propertyId} {
      // The responsible owner / agent also reads their own non-public listings.
      allow read: if resource.data.status == 'published'
        || (signedIn() && (resource.data.ownerId == request.auth.uid
                           || resource.data.agentId == request.auth.uid))
        || isAdmin();

      // Module 08: owners and agents create ONLY pending_review listings that belong
      // to them. Nobody but an admin can create a `published` document or set another
      // user as owner. Content edits arrive with B3 (edit mode).
      allow create: if isAdmin() || (canPublish() && validNewListing(request.resource.data));

      // Module 09: owner / agent move ONLY status + updatedAt along lifecycleMove().
      // Never published / suspended / expired, never ownerId, agentId, counters.
      allow update: if isAdmin() || lifecycleMove();

      // Owners may delete only what is not live or under review.
      allow delete: if isAdmin()
        || (signedIn()
            && resource.data.ownerId == request.auth.uid
            && resource.data.status in ['draft', 'rejected', 'removed']);
    }

    // ---- Module 07: favorites (document id = {userId}_{propertyId}) ----------
    match /favorites/{favoriteId} {
      allow get: if signedIn()
        && (resource == null || resource.data.userId == request.auth.uid);

      allow list: if signedIn() && resource.data.userId == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['userId', 'propertyId', 'createdAt'])
        && request.resource.data.keys().hasOnly(['userId', 'propertyId', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.propertyId is string
        && favoriteId == request.auth.uid + '_' + request.resource.data.propertyId
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data.status == 'published';

      allow update: if false;

      allow delete: if signedIn()
        && (resource == null || resource.data.userId == request.auth.uid);
    }

    // ---- Module 10: public professional profile -------------------------------
    function validProfile(d) {
      return d.professionalName is string && d.professionalName.trim().size() >= 3 && d.professionalName.size() <= 80
        && d.description is string && d.description.size() >= 20 && d.description.size() <= 600
        && d.phone is string && d.phone.matches('^\\+216[2-579][0-9]{7}$')
        && d.publicEmail is string && d.publicEmail.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]{2,}$')
        && d.city is string && d.city.size() > 0
        && d.profileType in ['agent', 'agency']
        && (d.profileType != 'agency' || (d.agencyName is string && d.agencyName.size() > 0))
        && (d.website == null || (d.website is string && d.website.matches('^https?://.+')))
        && d.serviceAreas.size() <= 10 && d.languages.size() <= 6;
    }

    match /agent_profiles/{agentId} {
      allow read: if resource.data.isPublic == true || isSelf(agentId) || isAdmin();

      allow create: if isSelf(agentId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.verificationStatus == 'not_submitted'   // cannot self-verify
        && request.resource.data.agencyId == null
        && validProfile(request.resource.data)
        && request.resource.data.keys().hasOnly(['userId', 'professionalName', 'description', 'phone',
             'publicEmail', 'city', 'profileType', 'agencyName', 'agencyId', 'profileImageUrl', 'address',
             'website', 'yearsOfExperience', 'languages', 'serviceAreas', 'verificationStatus',
             'showPhone', 'showEmail', 'isPublic', 'createdAt', 'updatedAt']);

      allow update: if (isSelf(agentId)
          && unchanged(['userId', 'agencyId', 'verificationStatus', 'createdAt'])
          && validProfile(request.resource.data))
        // Module 13: the badge follows the agent's verification request, in the same
        // admin batch that decides it. Nothing else changes.
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verificationStatus'])
          && getAfter(/databases/$(database)/documents/verifications/$('agent_' + agentId)).data.status
               == request.resource.data.verificationStatus);

      allow delete: if isAdmin();
    }

    // ---- Module 10: trusted counters (written by Cloud Functions only) ---------
    match /property_stats/{propertyId} {
      allow read: if signedIn() && (resource.data.agentId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ---- Module 10: analytics events (create-only, own uid) --------------------
    match /property_events/{eventId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['type', 'propertyId', 'userId', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.type == 'property_view'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    // ---- Module 13: verification requests -----------------------------------------
    // One document per target: `{targetType}_{targetId}`. Every status change is ONE
    // batch (request + history entry + audit log + notification [+ badge]); the rules
    // use getAfter()/existsAfter() so a status never changes without its history and
    // a badge never changes without the matching request.
    //   applicant: not_submitted -> pending, rejected|expired -> pending
    //   admin:     pending -> approved|rejected, approved -> expired
    function verifPath(vid) { return /databases/$(database)/documents/verifications/$(vid); }

    function verifKeys() {
      return ['id', 'applicantId', 'targetId', 'targetType', 'status', 'submittedData', 'documents',
              'reviewedBy', 'reviewedAt', 'decision', 'rejectionReason', 'createdAt', 'updatedAt',
              'submittedAt', 'expiresAt', 'attemptNumber'];
    }

    // user / owner / agent: always your own account. property: a listing you own or manage.
    function ownsVerificationTarget(type, targetId) {
      return (type in ['user', 'owner', 'agent'] && targetId == request.auth.uid)
        || (type == 'property'
            && exists(/databases/$(database)/documents/properties/$(targetId))
            && (get(/databases/$(database)/documents/properties/$(targetId)).data.ownerId == request.auth.uid
                || get(/databases/$(database)/documents/properties/$(targetId)).data.get('agentId', null) == request.auth.uid));
    }

    // Fields shared by a first submission and a resubmission: pending, no decision.
    function validPendingRequest(d) {
      return d.status == 'pending'
        && d.submittedData is map
        && d.documents is list && d.documents.size() > 0 && d.documents.size() <= 12
        && d.reviewedBy == null && d.reviewedAt == null && d.decision == null
        && d.rejectionReason == null && d.expiresAt == null
        && d.attemptNumber is int
        && d.submittedAt == request.time && d.updatedAt == request.time;
    }

    match /verifications/{id} {
      // `applicantId` lets "my requests" run where('applicantId' == uid).
      // `targetId` keeps requests made by the Module 10 agent screen readable.
      // `resource == null`: the app first reads its own `{type}_{target}` id to know
      // whether a request exists; a missing document reveals nothing.
      allow read: if signedIn()
        && (resource == null
            || resource.data.get('applicantId', null) == request.auth.uid
            || resource.data.targetId == request.auth.uid
            || isAdmin());

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(verifKeys())
        && request.resource.data.id == id
        && request.resource.data.targetType is string
        && request.resource.data.targetId is string
        && id == request.resource.data.targetType + '_' + request.resource.data.targetId
        && request.resource.data.applicantId == request.auth.uid
        && ownsVerificationTarget(request.resource.data.targetType, request.resource.data.targetId)
        && validPendingRequest(request.resource.data)
        && request.resource.data.attemptNumber == 1
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/verifications/$(id)/history/1_submitted);

      allow update: if
        // Applicant resubmits after a rejection or an expiry: a new attempt.
        (signedIn()
          && resource.data.get('applicantId', null) == request.auth.uid
          && resource.data.status in ['rejected', 'expired']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
               ['status', 'submittedData', 'documents', 'reviewedBy', 'reviewedAt', 'decision',
                'rejectionReason', 'updatedAt', 'submittedAt', 'expiresAt', 'attemptNumber'])
          && validPendingRequest(request.resource.data)
          && request.resource.data.attemptNumber == resource.data.attemptNumber + 1
          && existsAfter(/databases/$(database)/documents/verifications/$(id)/history/$(string(request.resource.data.attemptNumber) + '_resubmitted')))
        // Administrator decides a pending request, or expires an approved one.
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
               ['status', 'updatedAt', 'reviewedBy', 'reviewedAt', 'decision', 'rejectionReason', 'expiresAt'])
          && request.resource.data.updatedAt == request.time
          && ((resource.data.status == 'pending'
                && request.resource.data.status in ['approved', 'rejected']
                && request.resource.data.decision == request.resource.data.status
                && request.resource.data.reviewedBy == request.auth.uid
                && request.resource.data.reviewedAt == request.time
                && ((request.resource.data.status == 'approved'
                      && request.resource.data.rejectionReason == null)
                    || (request.resource.data.status == 'rejected'
                      && request.resource.data.rejectionReason is string
                      && request.resource.data.rejectionReason.size() > 0
                      && request.resource.data.rejectionReason.size() <= 1000)))
              || (resource.data.status == 'approved'
                && request.resource.data.status == 'expired'
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])))
          && existsAfter(/databases/$(database)/documents/verifications/$(id)/history/$(string(resource.data.attemptNumber) + '_' + request.resource.data.status)));

      allow delete: if false;

      // Append-only trail. An entry is accepted only when the request reaches exactly
      // that status and attempt in the same batch, and only once (fixed ids).
      match /history/{hid} {
        allow read: if signedIn()
          && (get(verifPath(id)).data.get('applicantId', null) == request.auth.uid || isAdmin());

        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(
               ['action', 'actorId', 'actorRole', 'previousStatus', 'newStatus', 'reason', 'attemptNumber', 'createdAt'])
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.attemptNumber is int
          && hid == string(request.resource.data.attemptNumber) + '_' + request.resource.data.action
          && getAfter(verifPath(id)).data.status == request.resource.data.newStatus
          && getAfter(verifPath(id)).data.attemptNumber == request.resource.data.attemptNumber
          && ((!exists(verifPath(id)) && request.resource.data.previousStatus == 'not_submitted')
              || (exists(verifPath(id)) && get(verifPath(id)).data.status == request.resource.data.previousStatus))
          && ((request.resource.data.actorRole == 'applicant'
                && request.resource.data.action in ['submitted', 'resubmitted']
                && getAfter(verifPath(id)).data.applicantId == request.auth.uid)
              || (request.resource.data.actorRole == 'admin'
                && request.resource.data.action in ['approved', 'rejected', 'expired']
                && isAdmin()));

        allow update, delete: if false;
      }

      match /private/{doc} { allow read, write: if isAdmin(); }
    }

    // ---- Module 10 / 09 base: conversations (participants only) ----------------
    // Queries are checked against the rule, not filtered by it: the agent inbox runs
    // where('recipientId' == uid), which `isConversationParty()` can prove
    // (the old `uid in participants` could not). `participants` is always
    // [userId, recipientId] (enforced on create), so access is unchanged.
    function isConversationParty() {
      return resource.data.userId == request.auth.uid
          || resource.data.recipientId == request.auth.uid;
    }

    function otherParty(convo) {
      return convo.userId == request.auth.uid ? convo.recipientId : convo.userId;
    }

    match /conversations/{cid} {
      // Module 11: the Messages tab lists every thread with
      // where('participants', arrayContains: uid); `uid in participants` is what
      // lets the rules prove that query. participants == [userId, recipientId].
      allow list: if signedIn()
        && (isConversationParty() || request.auth.uid in resource.data.participants);

      // Single read. The id is `{propertyId}_{uid}`: a user may probe their OWN id
      // before the thread exists (openOrCreate does a get() first).
      allow get: if signedIn() && (
           (resource != null && isConversationParty())
        || (resource == null && cid.matches('.+_' + request.auth.uid)));

      allow create: if signedIn()
        && cid == request.resource.data.propertyId + '_' + request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.recipientId != request.auth.uid
        && request.resource.data.participants == [request.auth.uid, request.resource.data.recipientId]
        && get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data.status == 'published'
        && request.resource.data.recipientId ==
           (get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data.agentId != null
             ? get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data.agentId
             : get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data.ownerId);

      // A participant updates the preview and ONLY their own read time: they can
      // never mark a thread as seen by the other side.
      allow update: if signedIn() && request.auth.uid in resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lastMessage', 'lastMessageAt', 'lastSenderId', 'lastReadAt'])
        && request.resource.data.get('lastReadAt', {}).diff(resource.data.get('lastReadAt', {}))
             .affectedKeys().hasOnly([request.auth.uid]);

      match /messages/{mid} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(cid)).data.participants;
        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(cid)).data.participants
          // Module 14: not if the other participant blocked me.
          && !exists(/databases/$(database)/documents/users/$(otherParty(get(/databases/$(database)/documents/conversations/$(cid)).data))/blocked/$(request.auth.uid))
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    // ---- Module 12: notifications ---------------------------------------------
    // Only Cloud Functions create them (Admin SDK bypasses rules). The recipient
    // reads them, marks them read (read: true, optional readAt = server time) and
    // may delete them from their notification center.
    match /notifications/{nid} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt'])
        && request.resource.data.read == true
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['readAt'])
            || request.resource.data.readAt == request.time);
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
      // Cloud Functions write with the Admin SDK (no rule needed). On the Spark
      // plan the admin app writes them itself (Module 15: moderation notices,
      // announcements); an applicant may notify THEMSELVES of a submitted
      // verification (Module 13).
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['userId', 'type', 'title', 'body', 'read', 'readAt', 'propertyId', 'conversationId', 'targetId', 'data', 'createdAt'])
        && request.resource.data.userId is string
        && request.resource.data.title is string && request.resource.data.title.size() <= 120
        && request.resource.data.body is string && request.resource.data.body.size() <= 1000
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time
        && (isAdmin()
            || (request.resource.data.userId == request.auth.uid
                && request.resource.data.type == 'verificationSubmitted'));
    }

    // ---- Module 15: audit trail (append-only) ----------------------------------
    // Admin actions are logged by the admin app; an applicant logs their own
    // verification submission (Module 13). Nobody edits or deletes an entry.
    match /audit_logs/{id} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['actorId', 'actorRole', 'action', 'targetType', 'targetId', 'verificationId',
              'previousStatus', 'newStatus', 'reason', 'details', 'timestamp'])
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.action is string
        && request.resource.data.timestamp == request.time
        && ((request.resource.data.actorRole == 'admin' && isAdmin())
            || (request.resource.data.actorRole == 'applicant'
                && request.resource.data.action.matches('verification[.].*')));
      allow update, delete: if false;
    }

    // ---- Module 14: reports --------------------------------------------------------
    // Id = {reporterId}_{targetType}_{targetId}: one report per reporter and target.
    // Reporters create and follow their own; admins run the lifecycle
    // open -> investigating -> resolved | rejected.
    match /reports/{rid} {
      allow get: if signedIn() && (
           isAdmin()
        || (resource == null && rid.matches(request.auth.uid + '_.+'))
        || (resource != null && resource.data.reporterId == request.auth.uid));
      allow list: if signedIn() && (isAdmin() || resource.data.reporterId == request.auth.uid);

      allow create: if signedIn()
        && isActiveAccount()
        && request.resource.data.keys().hasOnly(['reporterId', 'targetType', 'targetId', 'targetLabel',
             'targetOwnerId', 'conversationId', 'propertyId', 'reason', 'reasonLabel', 'description',
             'status', 'priority', 'createdAt', 'updatedAt'])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetType in ['property', 'user', 'agent', 'message']
        && request.resource.data.targetId is string
        && request.resource.data.targetId != request.auth.uid
        && rid == request.auth.uid + '_' + request.resource.data.targetType + '_' + request.resource.data.targetId
        && (!('targetOwnerId' in request.resource.data) || request.resource.data.targetOwnerId != request.auth.uid)
        && request.resource.data.targetLabel is string && request.resource.data.targetLabel.size() <= 200
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 60
        && request.resource.data.reasonLabel is string && request.resource.data.reasonLabel.size() <= 60
        && request.resource.data.description is string && request.resource.data.description.size() <= 1000
        && request.resource.data.status == 'open'
        && request.resource.data.priority in ['high', 'medium', 'low']
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'assignedTo',
             'resolution', 'resolutionAction', 'closedAt', 'closedBy', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && (request.resource.data.status == resource.data.status
            || (resource.data.status == 'open' && request.resource.data.status == 'investigating')
            || (resource.data.status == 'investigating'
                && request.resource.data.status in ['resolved', 'rejected']
                && request.resource.data.resolution is string
                && request.resource.data.resolution.size() >= 5
                && request.resource.data.closedBy == request.auth.uid));
      allow delete: if false;
    }

    // ---- Module 16: content lists (catalog/{key}) ------------------------------
    match /catalog/{key} {
      allow read: if true;
      allow write: if isAdmin()
        && key in ['property_types', 'amenities', 'cities', 'areas', 'tags',
                   'verification_categories', 'report_reasons']
        && request.resource.data.keys().hasOnly(['items', 'updatedAt', 'updatedBy'])
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 200
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    // ---- Module 17: platform settings (settings/platform) ----------------------
    // Same bounds as PlatformSettings in Flutter. Change them together.
    function validPlatformSettings(d) {
      return d.keys().hasOnly(['maxImages', 'maxImageSizeMb', 'listingExpirationDays',
               'requireListingReview', 'announcementsEnabled', 'serverNotifications',
               'supportedCurrencies', 'termsText', 'privacyText',
               'contactEmail', 'contactPhone', 'contactAddress', 'updatedAt', 'updatedBy'])
        && d.maxImages is int && d.maxImages >= 1 && d.maxImages <= 10
        && d.maxImageSizeMb is int && d.maxImageSizeMb >= 1 && d.maxImageSizeMb <= 5
        && d.listingExpirationDays is int && d.listingExpirationDays >= 7 && d.listingExpirationDays <= 365
        && d.requireListingReview is bool
        && d.announcementsEnabled is bool
        && d.serverNotifications is bool
        && d.supportedCurrencies is list && d.supportedCurrencies.size() >= 1
        && d.supportedCurrencies.hasOnly(['TND', 'EUR', 'USD'])
        && d.termsText is string && d.termsText.size() <= 20000
        && d.privacyText is string && d.privacyText.size() <= 20000
        && d.contactEmail is string && d.contactEmail.size() <= 120
        && d.contactPhone is string && d.contactPhone.size() <= 30
        && d.contactAddress is string && d.contactAddress.size() <= 200
        && d.updatedBy == request.auth.uid
        && d.updatedAt == request.time;
    }

    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin() && doc == 'platform' && validPlatformSettings(request.resource.data);
    }

    // ---- Module 12: email queue (Trigger Email extension) — server only --------
    match /mail/{id} {
      allow read, write: if false;
    }
  }
}
