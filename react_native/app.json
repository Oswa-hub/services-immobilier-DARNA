{
  "expo": {
    "name": "DARNA",
    "slug": "darna-rn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F6F5C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.darna.rn"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "DARNA utilise vos photos pour illustrer vos annonces."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "DARNA utilise votre position pour afficher les biens proches."
        }
      ]
    ],
    "scheme": "darna"
  }
}